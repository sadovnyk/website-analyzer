# MySQL (host port 3307 is mapped in docker-compose.yaml)
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=analyzer
DB_PASSWORD=your_password
DB_NAME=website_monitor

# MongoDB (host port 27018 is mapped in docker-compose.yaml)
MONGO_USER=your_user
MONGO_PASSWORD=your_password
MONGO_URI=mongodb://your_user:your_password@127.0.0.1:27018/?authSource=admin
MONGO_DB=website_monitor
MONGO_CL=scan_links
SCHEDULER_INTERVAL_SECONDS=900